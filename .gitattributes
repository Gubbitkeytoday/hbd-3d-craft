# Auto detect text files and perform LF normalization
* text=auto

# Binary files - never convert line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.ogg binary
*.zip binary
*.gz binary
*.tar binary
